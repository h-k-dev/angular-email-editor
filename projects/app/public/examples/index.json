    {
      "key": "angularjs",
      "label": "AngularJS expression example",
      "short": "AngularJS",
      "kind": "html",
      "dialect": "angularjs",
      "examples": [
        {
          "name": "Platzhalter im Überblick",
          "file": "angularjs/platzhalter-im-ueberblick.html"
        },
        {
          "name": "Sign-in code",
          "file": "angularjs/sign-in-code.html",
          "envelope": {
            "from": ["no-reply@example.com"],
            "subject": "{{ otp.code }} is your {{ company.name }} sign-in code",
            "previewText": "Valid for {{ otp.minutes }} minutes. Never share this code."
          }
        },
        {
          "name": "Order confirmation",
          "file": "angularjs/order-confirmation.html",
          "envelope": {
            "from": ["orders@example.com"],
            "subject": "Your order {{ order.number }} is confirmed",
            "previewText": "Thank you — we are packing it now."
          }
        },
        {
          "name": "Shipping confirmation",
          "file": "angularjs/shipping-confirmation.html",
          "envelope": {
            "from": ["shipping@example.com"],
            "subject": "Your parcel from {{ shipment.merchant }} is on its way",
            "previewText": "Expected {{ shipment.eta }}, {{ shipment.window }}. Not at home? Change it for free."
          }
        },
        {
          "name": "Welcome",
          "file": "angularjs/welcome.html",
          "envelope": {
            "from": ["hello@example.com"],
            "subject": "Welcome to {{ company.name }}, {{ firstName }}",
            "previewText": "Your account is ready. Finish your profile in a minute."
          }
        },
        {
          "name": "Rechteanfrage",
          "file": "angularjs/rechteanfrage.html",
          "envelope": {
            "from": ["legal@example.com"],
            "subject": "Nutzungsrechte für „{{ clearance.production }}“ – Az. {{ clearance.caseNumber }}",
            "previewText": "Fotografie: {{ clearance.photographer }}. Angebotene Lizenzgebühr: {{ clearance.fee }} €."
          }
        },
        {
          "name": "Rechnung",
          "file": "angularjs/rechnung.html",
          "envelope": {
            "from": ["billing@example.com"],
            "subject": "Rechnung Nr. 46786 zu Vorgang {{ case_number }}",
            "previewText": "Zahlbar innerhalb von 14 Tagen."
          }
        }
      ]
